# Supabase 專案 URL
VITE_SUPABASE_URL=https://你的-project-ref.supabase.co

# Supabase anon public key（Project Settings → API → anon public）
VITE_SUPABASE_ANON_KEY=你的-anon-key

# Supabase Storage bucket 名稱，需與 supabase_init.sql 一致
VITE_SUPABASE_STORAGE_BUCKET=senior-center-images

# /admin 固定密碼；若不設定，程式預設為 114774
VITE_ADMIN_PASSWORD=114774
